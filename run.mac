/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Optional: parametric anode (see anode.mac for full example)
#/xtube/anode/setMaterial G4_Cu
#/xtube/anode/setThickness 2 mm
#/xtube/anode/setAngle 20 deg

# Optional: parametric filter (see filter.mac for full example)
#/xtube/filter/setMaterial G4_Al
#/xtube/filter/setThickness 0.5 mm
#/xtube/filter/setDiameter 25 mm
#/xtube/filter/setPosition 0 -17.8 20 mm
#/xtube/filter/setNormal 0 -1 0

# Detector configuration comes from the macro (see detectors.mac)
/control/execute detectors.mac

/run/initialize

/gun/particle e-
#/gun/particle e+
/gun/energy 160 keV
/run/beamOn 1000
